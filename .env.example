# Copy to .env (gitignored). LOCAL_LLM_* is the current prefix; SPARK_LLM_* still works.
OPENAI_API_KEY=            # only for `--provider openai` runs; never written to artifacts
# OPENAI_BASE_URL=https://api.openai.com/v1
LOCAL_LLM_EDGAR_USER_AGENT="local-llm you@example.com"   # SEC EDGAR fair-access requirement
# LOCAL_LLM_BACKEND=vulkan       # Halo: vulkan | rocm (Spark ignores)
# LOCAL_LLM_MODELS_DIR=          # override the platform default weights directory
# GITHUB_TOKEN=                  # raises the API rate limit for `local-llm build` on Halo
